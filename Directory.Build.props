<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Alaeddine Gallas</Authors>
    <Copyright>Copyright (c) 2026 Alaeddine Gallas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alaeddineG/Wkeel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alaeddineG/Wkeel</RepositoryUrl>
    <PackageTags>mediator;in-process;domain-events;pipeline</PackageTags>
    <PackageReleaseNotes>https://github.com/alaeddineG/Wkeel/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

</Project>
